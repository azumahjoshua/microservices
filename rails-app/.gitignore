# Standard Rails ignores
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore uploaded files in development
/storage/*
!/storage/.keep

# Environment files
/.env*
!.env.example

# Dependency directories
/node_modules
/vendor/bundle
/.bundle

# Generated assets
/public/assets
/public/packs
/public/packs-test

# Cache files
.byebug_history
*.swp
*.swo

# IDE specific files
.idea/
.vscode/
*.swp

# OS metadata
.DS_Store

# Database files
/db/*.sqlite3
/db/*.sqlite3-*

# Test coverage
/coverage/

# Yarn artifacts
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Ruby version manager files
.ruby-version
.rbenv-vars

# Rails master key
/config/master.key
/config/credentials/*.key

# Temp files
*.orig
*~

# JavaScript tooling
/public/vite

# Asset pipeline
/public/vite-dev
/public/vite-test

# Docker
.env.local
